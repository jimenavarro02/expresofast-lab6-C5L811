{
  "info": {
    "name": "ExpresoFast Lab 6",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"admin\",\"password\":\"Password123!\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Envios optimizados",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/envios/optimizados"
      }
    },
    {
      "name": "Crear envio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"codigoRastreo\":\"EXP-1234\",\"direccionDestino\":\"Cartago\",\"pesoKg\":2.5,\"costo\":1500,\"vehiculoId\":1,\"conductorId\":1}"
        },
        "url": "{{baseUrl}}/api/envios"
      }
    },
    {
      "name": "Cambiar estado",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nuevoEstado\":\"EN_TRANSITO\",\"observaciones\":\"Salida de bodega\"}"
        },
        "url": "{{baseUrl}}/api/envios/1/estado"
      }
    },
    {
      "name": "Bitacora",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/envios/1/bitacora"
      }
    },
    {
      "name": "Vehiculos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/vehiculos"
      }
    }
  ]
}